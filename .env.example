# Database connection will be configured later.
DATABASE_URL=
EXLEASINGCAR_R2_ACCOUNT_ID=
EXLEASINGCAR_R2_BUCKET=
EXLEASINGCAR_R2_ACCESS_KEY_ID=
EXLEASINGCAR_R2_SECRET_ACCESS_KEY=

# Separate read-only Cloudflare API token with Account Analytics Read permission.
# The downloader fails closed when account-wide usage cannot be checked.
EXLEASINGCAR_CF_ACCOUNT_ANALYTICS_TOKEN=

# Local durable safety ledger. Keep this file between runs; it is ignored by Git.
EXLEASINGCAR_R2_BUDGET_DATABASE=data/r2_usage_budget.sqlite3

# Conservative stop thresholds (50% of the documented R2 Standard free tier).
# These values may be lowered, but the application rejects higher values.
EXLEASINGCAR_R2_BUDGET_MAX_CLASS_A=500000
EXLEASINGCAR_R2_BUDGET_MAX_CLASS_B=5000000
EXLEASINGCAR_R2_BUDGET_MAX_STORAGE_BYTES=5000000000
